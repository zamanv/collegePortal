# Copy this file to `.env` and fill in real values.  Never commit `.env`.

# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.vercel.app

# Database (defaults to the local PostgreSQL setup)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=college_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# On Render, set DATABASE_URL (Render injects it automatically for managed
# Postgres) and it takes precedence over the DB_* variables above:
# DATABASE_URL=postgresql://user:password@host:5432/college_db

# For a simple local setup without PostgreSQL you can use:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=C:/path/to/db.sqlite3

# Durable media storage: local | cloudinary | s3
STORAGE_BACKEND=local

# Cloudinary (when STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage (when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
